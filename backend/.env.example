PORT=5000
MONGODB_URI=mongodb://localhost:27017/healthcare
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Anthropic Claude API (Optional for LLM features, fallback mode works automatically)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google Calendar OAuth 2.0 (Optional for Calendar sync)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Email Configuration (Dev logs to stdout, Prod uses SendGrid or SMTP)
SENDGRID_API_KEY=SG.your-sendgrid-key
EMAIL_FROM=appointments@healthcarerx.com
